#include<bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        string s;
        cin>>s;
 
        if(s.length()%2==1)
        {
            cout<<"NO"<<endl;
        }
        else 
        {
            int flag = 1;
            for(int i = 0 ; i < s.length()/2 ; i++)
            {
                if(s[i]!=s[s.length()/2+i])
                {
                    flag =0;
                }
            }
 
            if(flag)
            {
                cout<<"YES"<<endl;
            }
            else
            {
                cout<<"NO"<<endl;
            }
        }
    }
}