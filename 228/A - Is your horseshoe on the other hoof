#include<bits/stdc++.h>
using namespace std;
 
int main()
{
    vector<int> inp(4);
 
    for(int i = 0 ; i < 4 ; i++)
    {
        cin >> inp[i];
    }
 
    int total = 0;
 
    for(int i = 0 ; i < 4 ; i++)
    {
        int cnt = count(inp.begin(), inp.begin() + i, inp[i]);
 
        if(cnt >= 1)
        {
            total++;
        }
    }
 
    cout << total;
 
    return 0;
}